"""Pure Python stdlib AST dataflow & stale-cell engine (DAG) for notebooks."""

from __future__ import annotations

import ast
import builtins
import hashlib
from collections import deque
from typing import Any

BUILTINS: frozenset[str] = frozenset(dir(builtins))

MUTATING_METHODS: frozenset[str] = frozenset(
    {
        "append",
        "extend",
        "insert",
        "pop",
        "remove",
        "clear",
        "sort",
        "reverse",
        "update",
        "setdefault",
        "add",
        "discard",
    }
)


def hash_source(source: str) -> str:
    """Stable SHA-256 hex digest of a cell's source text."""
    return hashlib.sha256(source.encode("utf-8")).hexdigest()


def _normalize_source(raw: Any) -> str:
    if isinstance(raw, list):
        return "".join(str(part) for part in raw)
    if isinstance(raw, str):
        return raw
    return ""


def _root_name(node: ast.AST) -> str | None:
    """Return the root ast.Name.id for attribute/subscript chains, else None."""
    cur = node
    while isinstance(cur, (ast.Attribute, ast.Subscript)):
        cur = cur.value
    if isinstance(cur, ast.Name):
        return cur.id
    return None


def _collect_target_names(target: ast.AST, out: set[str]) -> None:
    """Collect plain Name ids bound by an assignment/for/with/match target."""
    if isinstance(target, ast.Name):
        out.add(target.id)
    elif isinstance(target, (ast.Tuple, ast.List)):
        for elt in target.elts:
            _collect_target_names(elt, out)
    elif isinstance(target, ast.Starred):
        _collect_target_names(target.value, out)


def _collect_pattern_names(pattern: ast.AST, out: set[str]) -> None:
    """Collect variable names bound by a PEP 634 match pattern."""
    if hasattr(ast, "MatchAs") and isinstance(pattern, ast.MatchAs):
        if pattern.name:
            out.add(pattern.name)
        if pattern.pattern is not None:
            _collect_pattern_names(pattern.pattern, out)
    elif hasattr(ast, "MatchStar") and isinstance(pattern, ast.MatchStar):
        if pattern.name:
            out.add(pattern.name)
    elif hasattr(ast, "MatchOr") and isinstance(pattern, ast.MatchOr):
        for pat in pattern.patterns:
            _collect_pattern_names(pat, out)
    elif hasattr(ast, "MatchSequence") and isinstance(pattern, ast.MatchSequence):
        for pat in pattern.patterns:
            _collect_pattern_names(pat, out)
    elif hasattr(ast, "MatchMapping") and isinstance(pattern, ast.MatchMapping):
        for pat in pattern.patterns:
            _collect_pattern_names(pat, out)
        if pattern.rest:
            out.add(pattern.rest)
    elif hasattr(ast, "MatchClass") and isinstance(pattern, ast.MatchClass):
        for pat in pattern.patterns:
            _collect_pattern_names(pat, out)
        for pat in pattern.kwd_patterns:
            _collect_pattern_names(pat, out)


def _collect_arg_names(args: ast.arguments) -> set[str]:
    names: set[str] = set()
    for arg in args.posonlyargs:
        names.add(arg.arg)
    for arg in args.args:
        names.add(arg.arg)
    if args.vararg:
        names.add(args.vararg.arg)
    for arg in args.kwonlyargs:
        names.add(arg.arg)
    if args.kwarg:
        names.add(args.kwarg.arg)
    return names


def _scan_scope_decls(body: list[ast.stmt]) -> tuple[set[str], set[str], set[str]]:
    """Scan a function/class body for local bindings, global decls, nonlocal decls.

    Does not descend into nested FunctionDef, AsyncFunctionDef, ClassDef, or Lambda
    bodies; DOES scan comprehensions only for NamedExpr (:=) which leaks per PEP 572.
    """
    locals_: set[str] = set()
    globals_: set[str] = set()
    nonlocals_: set[str] = set()

    def scan_expr(expr: ast.AST | None) -> None:
        if expr is None:
            return
        if isinstance(expr, ast.Lambda):
            for default in expr.args.defaults:
                scan_expr(default)
            for default in expr.args.kw_defaults:
                scan_expr(default)
            return
        if isinstance(expr, ast.NamedExpr):
            if isinstance(expr.target, ast.Name):
                locals_.add(expr.target.id)
            scan_expr(expr.value)
            return
        for child in ast.iter_child_nodes(expr):
            scan_expr(child)

    def scan_stmts(stmts: list[ast.stmt]) -> None:
        for stmt in stmts:
            if isinstance(stmt, ast.Global):
                globals_.update(stmt.names)
            elif isinstance(stmt, ast.Nonlocal):
                nonlocals_.update(stmt.names)
            elif isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
                locals_.add(stmt.name)
                for dec in stmt.decorator_list:
                    scan_expr(dec)
                for d in stmt.args.defaults:
                    scan_expr(d)
                for d in stmt.args.kw_defaults:
                    scan_expr(d)
            elif isinstance(stmt, ast.ClassDef):
                locals_.add(stmt.name)
                for dec in stmt.decorator_list:
                    scan_expr(dec)
                for base in stmt.bases:
                    scan_expr(base)
                for kw in stmt.keywords:
                    scan_expr(kw.value)
            elif isinstance(stmt, ast.Assign):
                for target in stmt.targets:
                    _collect_target_names(target, locals_)
                scan_expr(stmt.value)
            elif isinstance(stmt, ast.AnnAssign):
                if isinstance(stmt.target, ast.Name):
                    locals_.add(stmt.target.id)
                scan_expr(stmt.annotation)
                scan_expr(stmt.value)
            elif isinstance(stmt, ast.AugAssign):
                if isinstance(stmt.target, ast.Name):
                    locals_.add(stmt.target.id)
                scan_expr(stmt.value)
            elif isinstance(stmt, (ast.For, ast.AsyncFor)):
                _collect_target_names(stmt.target, locals_)
                scan_expr(stmt.iter)
                scan_stmts(stmt.body)
                scan_stmts(stmt.orelse)
            elif isinstance(stmt, (ast.With, ast.AsyncWith)):
                for item in stmt.items:
                    scan_expr(item.context_expr)
                    if item.optional_vars is not None:
                        _collect_target_names(item.optional_vars, locals_)
                scan_stmts(stmt.body)
            elif isinstance(stmt, ast.Import):
                for alias in stmt.names:
                    locals_.add(alias.asname or alias.name.split(".")[0])
            elif isinstance(stmt, ast.ImportFrom):
                for alias in stmt.names:
                    if alias.name != "*":
                        locals_.add(alias.asname or alias.name)
            elif isinstance(stmt, ast.Delete):
                for target in stmt.targets:
                    if isinstance(target, ast.Name):
                        locals_.add(target.id)
            elif isinstance(stmt, ast.If):
                scan_expr(stmt.test)
                scan_stmts(stmt.body)
                scan_stmts(stmt.orelse)
            elif isinstance(stmt, ast.While):
                scan_expr(stmt.test)
                scan_stmts(stmt.body)
                scan_stmts(stmt.orelse)
            elif isinstance(stmt, ast.Try) or (
                hasattr(ast, "TryStar") and isinstance(stmt, ast.TryStar)
            ):
                scan_stmts(stmt.body)
                for handler in stmt.handlers:
                    scan_expr(handler.type)
                    if handler.name:
                        locals_.add(handler.name)
                    scan_stmts(handler.body)
                scan_stmts(stmt.orelse)
                scan_stmts(stmt.finalbody)
            elif hasattr(ast, "Match") and isinstance(stmt, ast.Match):
                scan_expr(stmt.subject)
                for case in stmt.cases:
                    _collect_pattern_names(case.pattern, locals_)
                    scan_expr(case.guard)
                    scan_stmts(case.body)
            else:
                for child in ast.iter_child_nodes(stmt):
                    if isinstance(child, ast.expr):
                        scan_expr(child)

    scan_stmts(body)
    locals_ -= globals_
    locals_ -= nonlocals_
    return locals_, globals_, nonlocals_


class _Scope:
    def __init__(
        self,
        kind: str,
        locals_: set[str] | None = None,
        globals_: set[str] | None = None,
        nonlocals_: set[str] | None = None,
    ) -> None:
        # kind: "module" | "function" | "class" | "comprehension" | "lambda"
        self.kind = kind
        self.locals: set[str] = set(locals_ or ())
        self.globals: set[str] = set(globals_ or ())
        self.nonlocals: set[str] = set(nonlocals_ or ())
        self.bound: set[str] = set()


class _CellAnalyzer:
    """Single-cell AST symbol extractor respecting Python lexical scoping."""

    def __init__(self) -> None:
        self.defs: set[str] = set()
        self.reads: set[str] = set()
        self.deferred_reads: set[str] = set()
        self.mutations: set[str] = set()
        self.scopes: list[_Scope] = [_Scope("module")]

    @property
    def _cur(self) -> _Scope:
        return self.scopes[-1]

    def _in_deferred_scope(self) -> bool:
        return any(s.kind in ("function", "lambda") for s in self.scopes[1:])

    def _is_bound_in_enclosing_local(self, name: str) -> bool:
        """True if `name` resolves to a local in a non-module scope."""
        cur = self._cur
        if name in cur.globals:
            return False
        # Walk from innermost scope outward toward (but not including) module.
        for idx in range(len(self.scopes) - 1, 0, -1):
            scope = self.scopes[idx]
            if scope.kind == "class" and idx != len(self.scopes) - 1:
                # Class scopes are not visible to nested functions/comprehensions.
                continue
            if name in scope.globals:
                return False
            if name in scope.locals or name in scope.bound:
                return True
        return False

    def _record_read(self, name: str) -> None:
        if name in BUILTINS:
            return
        if self._is_bound_in_enclosing_local(name):
            return
        mod = self.scopes[0]
        if name in mod.bound:
            return
        if self._in_deferred_scope():
            self.deferred_reads.add(name)
        else:
            self.reads.add(name)

    def _record_module_def(self, name: str) -> None:
        self.defs.add(name)
        if not self._in_deferred_scope():
            self.scopes[0].bound.add(name)

    def _record_mutation(self, name: str) -> None:
        if name in BUILTINS:
            return
        if self._is_bound_in_enclosing_local(name):
            return
        mod = self.scopes[0]
        if name not in mod.bound:
            if self._in_deferred_scope():
                self.deferred_reads.add(name)
            else:
                self.reads.add(name)
        self.mutations.add(name)

    def _bind_name(self, name: str, *, walrus: bool = False) -> None:
        # Determine target scope (for walrus inside comprehension, walk out to enclosing non-comp)
        target_idx = len(self.scopes) - 1
        if walrus:
            while target_idx > 0 and self.scopes[target_idx].kind == "comprehension":
                target_idx -= 1
        scope = self.scopes[target_idx]
        if scope.kind == "module":
            self._record_module_def(name)
        elif name in scope.globals:
            self._record_module_def(name)
        elif name in scope.nonlocals:
            # Rebinds an enclosing function local; not a cell-level def.
            pass
        else:
            scope.bound.add(name)
            scope.locals.add(name)

    def _visit_target(self, target: ast.AST, *, walrus: bool = False) -> None:
        if isinstance(target, ast.Name):
            self._bind_name(target.id, walrus=walrus)
        elif isinstance(target, (ast.Tuple, ast.List)):
            for elt in target.elts:
                self._visit_target(elt, walrus=walrus)
        elif isinstance(target, ast.Starred):
            self._visit_target(target.value, walrus=walrus)
        elif isinstance(target, ast.Attribute):
            root = _root_name(target)
            if root is not None:
                self._record_mutation(root)
            else:
                self.visit(target.value)
        elif isinstance(target, ast.Subscript):
            self.visit(target.slice)
            root = _root_name(target)
            if root is not None:
                self._record_mutation(root)
            else:
                self.visit(target.value)

    def _visit_pattern(self, pattern: ast.AST) -> None:
        if hasattr(ast, "MatchValue") and isinstance(pattern, ast.MatchValue):
            self.visit(pattern.value)
        elif hasattr(ast, "MatchAs") and isinstance(pattern, ast.MatchAs):
            if pattern.pattern is not None:
                self._visit_pattern(pattern.pattern)
            if pattern.name:
                self._bind_name(pattern.name)
        elif hasattr(ast, "MatchStar") and isinstance(pattern, ast.MatchStar):
            if pattern.name:
                self._bind_name(pattern.name)
        elif hasattr(ast, "MatchOr") and isinstance(pattern, ast.MatchOr):
            for pat in pattern.patterns:
                self._visit_pattern(pat)
        elif hasattr(ast, "MatchSequence") and isinstance(pattern, ast.MatchSequence):
            for pat in pattern.patterns:
                self._visit_pattern(pat)
        elif hasattr(ast, "MatchMapping") and isinstance(pattern, ast.MatchMapping):
            for key in pattern.keys:
                self.visit(key)
            for pat in pattern.patterns:
                self._visit_pattern(pat)
            if pattern.rest:
                self._bind_name(pattern.rest)
        elif hasattr(ast, "MatchClass") and isinstance(pattern, ast.MatchClass):
            self.visit(pattern.cls)
            for pat in pattern.patterns:
                self._visit_pattern(pat)
            for pat in pattern.kwd_patterns:
                self._visit_pattern(pat)

    def visit(self, node: ast.AST | None) -> None:
        if node is None:
            return
        method = getattr(self, f"visit_{type(node).__name__}", None)
        if method is not None:
            method(node)
        else:
            for child in ast.iter_child_nodes(node):
                self.visit(child)

    def visit_Module(self, node: ast.Module) -> None:
        for stmt in node.body:
            self.visit(stmt)

    def visit_Name(self, node: ast.Name) -> None:
        if isinstance(node.ctx, ast.Load):
            self._record_read(node.id)

    def visit_Assign(self, node: ast.Assign) -> None:
        self.visit(node.value)
        for target in node.targets:
            self._visit_target(target)

    def visit_AnnAssign(self, node: ast.AnnAssign) -> None:
        self.visit(node.annotation)
        if node.value is not None:
            self.visit(node.value)
            self._visit_target(node.target)
        elif isinstance(node.target, ast.Name) and self._cur.kind != "module":
            self._bind_name(node.target.id)

    def visit_AugAssign(self, node: ast.AugAssign) -> None:
        self.visit(node.value)
        if isinstance(node.target, ast.Name):
            self._record_read(node.target.id)
            self._bind_name(node.target.id)
        elif isinstance(node.target, ast.Attribute):
            root = _root_name(node.target)
            if root is not None:
                self._record_mutation(root)
            else:
                self.visit(node.target.value)
        elif isinstance(node.target, ast.Subscript):
            self.visit(node.target.slice)
            root = _root_name(node.target)
            if root is not None:
                self._record_mutation(root)
            else:
                self.visit(node.target.value)

    def visit_NamedExpr(self, node: ast.NamedExpr) -> None:
        self.visit(node.value)
        self._visit_target(node.target, walrus=True)

    def visit_Delete(self, node: ast.Delete) -> None:
        for target in node.targets:
            if isinstance(target, ast.Name):
                # del x marks symbol modified/removed at cell level if global/module
                if self._cur.kind == "module" or target.id in self._cur.globals:
                    self._record_read(target.id)
                    self.defs.add(target.id)
                    self.scopes[0].bound.discard(target.id)
            elif isinstance(target, (ast.Attribute, ast.Subscript)):
                if isinstance(target, ast.Subscript):
                    self.visit(target.slice)
                root = _root_name(target)
                if root is not None:
                    self._record_mutation(root)
                else:
                    self.visit(target.value)

    def visit_For(self, node: ast.For) -> None:
        self.visit(node.iter)
        self._visit_target(node.target)
        for stmt in node.body:
            self.visit(stmt)
        for stmt in node.orelse:
            self.visit(stmt)

    visit_AsyncFor = visit_For

    def visit_With(self, node: ast.With) -> None:
        for item in node.items:
            self.visit(item.context_expr)
            if item.optional_vars is not None:
                self._visit_target(item.optional_vars)
        for stmt in node.body:
            self.visit(stmt)

    visit_AsyncWith = visit_With

    def visit_Try(self, node: ast.Try) -> None:
        for stmt in node.body:
            self.visit(stmt)
        for handler in node.handlers:
            self.visit(handler.type)
            if handler.name:
                self._bind_name(handler.name)
            for stmt in handler.body:
                self.visit(stmt)
        for stmt in node.orelse:
            self.visit(stmt)
        for stmt in node.finalbody:
            self.visit(stmt)

    visit_TryStar = visit_Try

    def visit_Match(self, node: Any) -> None:
        self.visit(node.subject)
        for case in node.cases:
            self._visit_pattern(case.pattern)
            self.visit(case.guard)
            for stmt in case.body:
                self.visit(stmt)

    def visit_Import(self, node: ast.Import) -> None:
        for alias in node.names:
            name = alias.asname or alias.name.split(".")[0]
            self._bind_name(name)

    def visit_ImportFrom(self, node: ast.ImportFrom) -> None:
        for alias in node.names:
            if alias.name == "*":
                continue
            name = alias.asname or alias.name
            self._bind_name(name)

    def _visit_func_signature(self, node: ast.FunctionDef | ast.AsyncFunctionDef) -> None:
        for dec in node.decorator_list:
            self.visit(dec)
        for d in node.args.defaults:
            self.visit(d)
        for d in node.args.kw_defaults:
            self.visit(d)
        for arg in (
            node.args.posonlyargs
            + node.args.args
            + node.args.kwonlyargs
            + ([node.args.vararg] if node.args.vararg else [])
            + ([node.args.kwarg] if node.args.kwarg else [])
        ):
            self.visit(arg.annotation)
        self.visit(node.returns)

    def visit_FunctionDef(self, node: ast.FunctionDef | ast.AsyncFunctionDef) -> None:
        self._visit_func_signature(node)
        self._bind_name(node.name)
        arg_names = _collect_arg_names(node.args)
        body_locals, globals_, nonlocals_ = _scan_scope_decls(node.body)
        scope = _Scope(
            "function",
            locals_=arg_names | body_locals,
            globals_=globals_,
            nonlocals_=nonlocals_,
        )
        scope.bound.update(arg_names)
        self.scopes.append(scope)
        try:
            for stmt in node.body:
                self.visit(stmt)
        finally:
            self.scopes.pop()

    visit_AsyncFunctionDef = visit_FunctionDef

    def visit_ClassDef(self, node: ast.ClassDef) -> None:
        for dec in node.decorator_list:
            self.visit(dec)
        for base in node.bases:
            self.visit(base)
        for kw in node.keywords:
            self.visit(kw.value)
        self._bind_name(node.name)
        body_locals, globals_, nonlocals_ = _scan_scope_decls(node.body)
        scope = _Scope(
            "class",
            locals_=body_locals,
            globals_=globals_,
            nonlocals_=nonlocals_,
        )
        self.scopes.append(scope)
        try:
            for stmt in node.body:
                self.visit(stmt)
        finally:
            self.scopes.pop()

    def visit_Lambda(self, node: ast.Lambda) -> None:
        for d in node.args.defaults:
            self.visit(d)
        for d in node.args.kw_defaults:
            self.visit(d)
        arg_names = _collect_arg_names(node.args)
        scope = _Scope("lambda", locals_=arg_names)
        scope.bound.update(arg_names)
        self.scopes.append(scope)
        try:
            self.visit(node.body)
        finally:
            self.scopes.pop()

    def _visit_comprehension(
        self, generators: list[ast.comprehension], body_exprs: list[ast.AST]
    ) -> None:
        if not generators:
            for expr in body_exprs:
                self.visit(expr)
            return
        # First generator's iterable is evaluated in the enclosing scope.
        self.visit(generators[0].iter)
        scope = _Scope("comprehension")
        self.scopes.append(scope)
        try:
            for idx, gen in enumerate(generators):
                if idx > 0:
                    self.visit(gen.iter)
                self._visit_target(gen.target)
                for cond in gen.ifs:
                    self.visit(cond)
            for expr in body_exprs:
                self.visit(expr)
        finally:
            self.scopes.pop()

    def visit_ListComp(self, node: ast.ListComp) -> None:
        self._visit_comprehension(node.generators, [node.elt])

    def visit_SetComp(self, node: ast.SetComp) -> None:
        self._visit_comprehension(node.generators, [node.elt])

    def visit_GeneratorExp(self, node: ast.GeneratorExp) -> None:
        self._visit_comprehension(node.generators, [node.elt])

    def visit_DictComp(self, node: ast.DictComp) -> None:
        self._visit_comprehension(node.generators, [node.key, node.value])

    def visit_Call(self, node: ast.Call) -> None:
        is_inplace = any(
            kw.arg == "inplace"
            and isinstance(kw.value, ast.Constant)
            and kw.value.value is True
            for kw in node.keywords
        )
        if isinstance(node.func, ast.Attribute) and (
            node.func.attr in MUTATING_METHODS or is_inplace
        ):
            root = _root_name(node.func.value)
            if root is not None:
                self._record_mutation(root)
            else:
                self.visit(node.func.value)
        else:
            self.visit(node.func)

        for arg in node.args:
            self.visit(arg)
        for kw in node.keywords:
            self.visit(kw.value)

    def finalize_reads(self) -> set[str]:
        # Deferred reads (inside def/lambda) resolved against module globals:
        # satisfied locally only if defined at top level of the same cell.
        resolved_deferred = self.deferred_reads - self.scopes[0].bound
        return self.reads | resolved_deferred


def extract_cell_symbols(source: str) -> dict[str, Any]:
    """Parse one code cell and extract {defs, reads, mutations, syntax_error}."""
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return {
            "defs": [],
            "reads": [],
            "mutations": [],
            "syntax_error": True,
        }
    analyzer = _CellAnalyzer()
    analyzer.visit(tree)
    return {
        "defs": sorted(analyzer.defs),
        "reads": sorted(analyzer.finalize_reads()),
        "mutations": sorted(analyzer.mutations),
        "syntax_error": False,
    }


def analyze(cells: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Analyze all cells in a notebook and construct the dataflow dependency graph."""
    entries: list[dict[str, Any]] = []
    for idx, cell in enumerate(cells):
        cell_type = cell.get("cell_type", "code")
        source = _normalize_source(cell.get("source", ""))
        src_hash = hash_source(source)
        if cell_type == "code":
            sym = extract_cell_symbols(source)
        else:
            sym = {"defs": [], "reads": [], "mutations": [], "syntax_error": False}
        entries.append(
            {
                "index": idx,
                "cell_type": cell_type,
                "defs": sym["defs"],
                "reads": sym["reads"],
                "mutations": sym["mutations"],
                "upstream": {},
                "downstream": {},
                "late_defs": {},
                "redefinitions": {},
                "syntax_error": sym["syntax_error"],
                "source_hash": src_hash,
            }
        )

    # First pass: track all cells that define/mutate each symbol for late-def detection.
    all_definers: dict[str, list[int]] = {}
    for entry in entries:
        idx = entry["index"]
        for sym in set(entry["defs"]) | set(entry["mutations"]):
            all_definers.setdefault(sym, []).append(idx)

    # Second pass: walk top-to-bottom to resolve edges, redefinitions, and late defs.
    last_def: dict[str, int] = {}
    for entry in entries:
        idx = entry["index"]
        if entry["cell_type"] != "code":
            continue

        # Resolve reads against most recent prior definition/mutation.
        for sym in entry["reads"]:
            if sym in last_def:
                src_idx = last_def[sym]
                entry["upstream"].setdefault(src_idx, []).append(sym)
                entries[src_idx]["downstream"].setdefault(idx, []).append(sym)
            else:
                later = [k for k in all_definers.get(sym, ()) if k > idx]
                if later:
                    entry["late_defs"][sym] = later

        # Detect redefinition / shadowing (defining a symbol already defined above without reading it).
        read_set = set(entry["reads"])
        for sym in entry["defs"]:
            if sym in last_def and sym not in read_set:
                entry["redefinitions"][sym] = last_def[sym]

        # Update last_def with defs and mutations from this cell.
        for sym in set(entry["defs"]) | set(entry["mutations"]):
            last_def[sym] = idx

    # Sort symbol lists in upstream/downstream maps deterministically.
    for entry in entries:
        entry["upstream"] = {
            k: sorted(v) for k, v in sorted(entry["upstream"].items())
        }
        entry["downstream"] = {
            k: sorted(v) for k, v in sorted(entry["downstream"].items())
        }

    return entries


def _get_exec_info(exec_state: Any, idx: int) -> dict[str, Any]:
    if isinstance(exec_state, dict):
        return exec_state.get(idx) or exec_state.get(str(idx)) or {}
    if isinstance(exec_state, list) and 0 <= idx < len(exec_state):
        return exec_state[idx] or {}
    return {}


def compute_stale(
    analysis: list[dict[str, Any]],
    exec_state: dict[int, dict[str, Any]] | list[dict[str, Any]],
) -> dict[int, dict[str, Any]]:
    """Compute stale cells and human-readable staleness reasons.

    Returns { cell_index: { "edited": bool, "reasons": [{ "from": idx, "symbols": [...], "kind": str }] } }.
    """
    n = len(analysis)
    # Track cells that are tainted (edited-stale or downstream of stale/newer upstream).
    # Only cells that have been executed (executed_hash or execution_count set) are
    # reported as stale, while taint still flows transitively through downstream edges.
    edited_stale: set[int] = set()
    executed: set[int] = set()
    exec_counts: dict[int, int | None] = {}

    for entry in analysis:
        idx = entry["index"]
        if entry["cell_type"] != "code":
            continue
        st = _get_exec_info(exec_state, idx)
        ex_hash = st.get("executed_hash")
        ex_count = st.get("execution_count")
        exec_counts[idx] = ex_count
        if ex_hash is not None or ex_count is not None:
            executed.add(idx)
        if ex_hash is not None and entry["source_hash"] != ex_hash:
            edited_stale.add(idx)

    # Walk in topological (notebook) order since all upstream edges have u < v.
    tainted: set[int] = set()
    stale: dict[int, dict[str, Any]] = {}

    for entry in analysis:
        idx = entry["index"]
        if entry["cell_type"] != "code":
            continue

        is_edited = idx in edited_stale
        reasons: list[dict[str, Any]] = []
        if is_edited:
            reasons.append({"from": idx, "symbols": [], "kind": "edited"})

        v_ec = exec_counts.get(idx)
        upstream_tainted = False

        for u, symbols in entry["upstream"].items():
            u_ec = exec_counts.get(u)
            if u in edited_stale:
                upstream_tainted = True
                reasons.append(
                    {"from": u, "symbols": list(symbols), "kind": "upstream_edited"}
                )
            elif u in tainted:
                upstream_tainted = True
                reasons.append(
                    {"from": u, "symbols": list(symbols), "kind": "transitive"}
                )
            elif u_ec is not None and idx in executed and (v_ec is None or u_ec > v_ec):
                upstream_tainted = True
                reasons.append(
                    {"from": u, "symbols": list(symbols), "kind": "upstream_rerun"}
                )

        if is_edited or upstream_tainted:
            tainted.add(idx)
            if idx in executed:
                stale[idx] = {"edited": is_edited, "reasons": reasons}

    return stale


def affected_slice(analysis: list[dict[str, Any]], start_index: int) -> list[int]:
    """Return [start_index] plus all transitive downstream code cells in notebook order."""
    if start_index < 0 or start_index >= len(analysis):
        return []
    if analysis[start_index]["cell_type"] != "code":
        return []

    visited: set[int] = {start_index}
    queue: deque[int] = deque([start_index])
    while queue:
        cur = queue.popleft()
        for nxt in analysis[cur]["downstream"]:
            if nxt not in visited and analysis[nxt]["cell_type"] == "code":
                visited.add(nxt)
                queue.append(nxt)
    return sorted(visited)


def upstream_slice(analysis: list[dict[str, Any]], target_index: int) -> list[int]:
    """Return minimal ordered list of ancestor code cells plus target_index."""
    if target_index < 0 or target_index >= len(analysis):
        return []
    if analysis[target_index]["cell_type"] != "code":
        return []

    visited: set[int] = {target_index}
    queue: deque[int] = deque([target_index])
    while queue:
        cur = queue.popleft()
        for prev in analysis[cur]["upstream"]:
            if prev not in visited and analysis[prev]["cell_type"] == "code":
                visited.add(prev)
                queue.append(prev)
    return sorted(visited)


def audit(
    analysis: list[dict[str, Any]],
    exec_state: dict[int, dict[str, Any]] | list[dict[str, Any]],
) -> list[dict[str, Any]]:
    """Audit notebook for reproducibility issues."""
    issues: list[dict[str, Any]] = []
    stale_map = compute_stale(analysis, exec_state)

    for entry in analysis:
        idx = entry["index"]
        if entry["cell_type"] != "code":
            continue

        if entry["syntax_error"]:
            issues.append(
                {
                    "kind": "syntax_error",
                    "cell": idx,
                    "related": None,
                    "symbols": [],
                    "message": f"Cell #{idx + 1} has a Python syntax error",
                }
            )
            continue

        st = _get_exec_info(exec_state, idx)
        v_ec = st.get("execution_count")

        if idx in stale_map:
            info = stale_map[idx]
            parts: list[str] = []
            for r in info["reasons"]:
                if r["kind"] == "edited":
                    parts.append("edited since last run")
                else:
                    syms = ", ".join(r["symbols"])
                    parts.append(f"← #{r['from'] + 1} ({syms})")
            issues.append(
                {
                    "kind": "stale",
                    "cell": idx,
                    "related": info["reasons"][0]["from"] if info["reasons"] else None,
                    "symbols": sorted(
                        {s for r in info["reasons"] for s in r["symbols"]}
                    ),
                    "message": f"Cell #{idx + 1} is stale: {'; '.join(parts)}",
                }
            )

        for u, symbols in entry["upstream"].items():
            u_st = _get_exec_info(exec_state, u)
            u_ec = u_st.get("execution_count")
            if v_ec is not None and u_ec is not None and u_ec > v_ec:
                issues.append(
                    {
                        "kind": "out_of_order",
                        "cell": idx,
                        "related": u,
                        "symbols": list(symbols),
                        "message": (
                            f"Cell #{idx + 1} [{v_ec}] ran before upstream "
                            f"cell #{u + 1} [{u_ec}] ({', '.join(symbols)})"
                        ),
                    }
                )
            elif v_ec is not None and u_ec is None:
                issues.append(
                    {
                        "kind": "unrun_dependency",
                        "cell": idx,
                        "related": u,
                        "symbols": list(symbols),
                        "message": (
                            f"Cell #{idx + 1} [{v_ec}] depends on unrun "
                            f"cell #{u + 1} ({', '.join(symbols)})"
                        ),
                    }
                )

        for sym, later_cells in sorted(entry["late_defs"].items()):
            first_later = later_cells[0]
            issues.append(
                {
                    "kind": "late_definition",
                    "cell": idx,
                    "related": first_later,
                    "symbols": [sym],
                    "message": (
                        f"Cell #{idx + 1} reads '{sym}' before it is defined "
                        f"in cell #{first_later + 1}"
                    ),
                }
            )

        for sym, prev_idx in sorted(entry["redefinitions"].items()):
            issues.append(
                {
                    "kind": "redefinition",
                    "cell": idx,
                    "related": prev_idx,
                    "symbols": [sym],
                    "message": (
                        f"Cell #{idx + 1} redefines '{sym}' (previously defined in cell #{prev_idx + 1})"
                    ),
                }
            )

    return issues
