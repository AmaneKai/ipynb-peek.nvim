def _rewrite_asset_url(url: str, token: str) -> str:
    u = url.strip()
    if not u or u.startswith(("http://", "https://", "data:", "/", "#")):
        return u
    encoded = urllib.parse.quote(u, safe="/")
    if token:
        return f"/asset?path={encoded}&token={urllib.parse.quote(token, safe='')}"
    return f"/asset?path={encoded}"


def _render_inline(text: str, token: str = "") -> str:
    placeholders: list[str] = []

    def stash(fragment: str) -> str:
        key = f"\x00PH{len(placeholders)}\x00"
        placeholders.append(fragment)
        return key

    # 1. Protect inline code spans
    def repl_code(m: re.Match[str]) -> str:
        return stash(f"<code>{html.escape(m.group(1))}</code>")

    s = re.sub(r"`([^`\n]+)`", repl_code, text)

    # 2. Protect inline math $...$ (single dollar, not preceded/followed by $)
    def repl_math(m: re.Match[str]) -> str:
        return stash(render_math(m.group(1), display=False))

    s = re.sub(r"(?<!\$)\$(?!\$)(?!\s)([^$\n]+?)(?<!\s)\$(?!\$)", repl_math, s)

    # 3. Images ![alt](url)
    def repl_img(m: re.Match[str]) -> str:
        alt = html.escape(m.group(1), quote=True)
        raw_url = m.group(2).strip()
        if not _is_safe_url(raw_url, allow_data_image=True):
            return stash(alt)
        url = _rewrite_asset_url(raw_url, token)
        return stash(f'<img src="{html.escape(url, quote=True)}" alt="{alt}">')

    s = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)", repl_img, s)

    # 4. Links [label](url)
    def repl_link(m: re.Match[str]) -> str:
        label = html.escape(m.group(1))
        raw_url = m.group(2).strip()
        if not _is_safe_url(raw_url, allow_data_image=False):
            return stash(label)
        return stash(
            f'<a href="{html.escape(raw_url, quote=True)}" target="_blank" rel="noopener">{label}</a>'
        )

    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", repl_link, s)

    # 5. Escape remaining plain text
    s = html.escape(s)

    # 6. Bold, italic, strikethrough
    s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"__(.+?)__", r"<strong>\1</strong>", s)
    s = re.sub(r"~~(.+?)~~", r"<del>\1</del>", s)
    s = re.sub(r"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", r"<em>\1</em>", s)
    s = re.sub(r"(?<!\w)_([^_]+)_(?!\w)", r"<em>\1</em>", s)

    for idx, frag in enumerate(placeholders):
        s = s.replace(f"\x00PH{idx}\x00", frag)
    return s


_TABLE_SEP_RE = re.compile(r"^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$")


def _split_table_row(line: str) -> list[str]:
    stripped = line.strip()
    if stripped.startswith("|"):
        stripped = stripped[1:]
    if stripped.endswith("|"):
        stripped = stripped[:-1]
    return [cell.strip() for cell in stripped.split("|")]


def render_markdown(text: str, token: str = "") -> str:
    """Clean pure-Python Markdown renderer (headings, fences, lists, tables, math, links)."""
    lines = text.replace("\r\n", "\n").split("\n")
    n = len(lines)
    i = 0
    out: list[str] = []

    while i < n:
        line = lines[i]
        stripped = line.strip()

        if not stripped:
            i += 1
            continue

        # Fenced code block ``` or ~~~
        fence_m = re.match(r"^\s*(`{3,}|~{3,})\s*([A-Za-z0-9_+-]*)\s*$", line)
        if fence_m:
            fence_char = fence_m.group(1)[0]
            fence_len = len(fence_m.group(1))
            lang = fence_m.group(2)
            code_lines: list[str] = []
            i += 1
            close_re = re.compile(rf"^\s*{re.escape(fence_char)}{{{fence_len},}}\s*$")
            while i < n and not close_re.match(lines[i]):
                code_lines.append(lines[i])
                i += 1
            if i < n:
                i += 1
            out.append(highlight_code("\n".join(code_lines), lang or "text"))
            continue

        # Block math $$...$$
        if stripped.startswith("$$"):
            if stripped.endswith("$$") and len(stripped) > 4:
                out.append(render_math(stripped[2:-2], display=True))
                i += 1
                continue
            math_lines = [stripped[2:]]
            i += 1
            while i < n and not lines[i].strip().endswith("$$"):
                math_lines.append(lines[i])
                i += 1
            if i < n:
                tail = lines[i].strip()[:-2]
                if tail:
                    math_lines.append(tail)
                i += 1
            out.append(render_math("\n".join(math_lines), display=True))
            continue

        # ATX Heading
        head_m = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", line)
        if head_m:
            level = len(head_m.group(1))
            out.append(f"<h{level}>{_render_inline(head_m.group(2), token)}</h{level}>")
            i += 1
            continue

        # Horizontal rule
        if re.match(r"^\s*([-*_])(?:\s*\1){2,}\s*$", line):
            out.append("<hr>")
            i += 1
            continue

        # Blockquote
        if re.match(r"^\s*>", line):
            bq_lines: list[str] = []
            while i < n and re.match(r"^\s*>", lines[i]):
                bq_lines.append(re.sub(r"^\s*>\s?", "", lines[i]))
                i += 1
            out.append(f"<blockquote>{render_markdown(chr(10).join(bq_lines), token)}</blockquote>")
            continue

        # Pipe table
        if "|" in line and i + 1 < n and _TABLE_SEP_RE.match(lines[i + 1]):
            headers = _split_table_row(line)
            i += 2
            rows: list[list[str]] = []
            while i < n and "|" in lines[i] and lines[i].strip():
                rows.append(_split_table_row(lines[i]))
                i += 1
            th_html = "".join(f"<th>{_render_inline(h, token)}</th>" for h in headers)
            body_html = "".join(
                "<tr>" + "".join(f"<td>{_render_inline(c, token)}</td>" for c in r) + "</tr>"
                for r in rows
            )
            out.append(
                f'<div class="table-scroll"><table><thead><tr>{th_html}</tr></thead>'
                f"<tbody>{body_html}</tbody></table></div>"
            )
            continue

        # Unordered list
        if re.match(r"^\s*[-*+]\s+", line):
            items: list[str] = []
            while i < n and re.match(r"^\s*[-*+]\s+", lines[i]):
                items.append(re.sub(r"^\s*[-*+]\s+", "", lines[i]))
                i += 1
            li_html = "".join(f"<li>{_render_inline(it, token)}</li>" for it in items)
            out.append(f"<ul>{li_html}</ul>")
            continue

        # Ordered list
        if re.match(r"^\s*\d+\.\s+", line):
            items = []
            while i < n and re.match(r"^\s*\d+\.\s+", lines[i]):
                items.append(re.sub(r"^\s*\d+\.\s+", "", lines[i]))
                i += 1
            li_html = "".join(f"<li>{_render_inline(it, token)}</li>" for it in items)
            out.append(f"<ol>{li_html}</ol>")
            continue

        # Paragraph
        para: list[str] = [line]
        i += 1
        while i < n:
            nxt = lines[i]
            if (
                not nxt.strip()
                or re.match(r"^\s*(`{3,}|~{3,})", nxt)
                or nxt.strip().startswith("$$")
                or re.match(r"^#{1,6}\s+", nxt)
                or re.match(r"^\s*>", nxt)
                or re.match(r"^\s*[-*+]\s+", nxt)
                or re.match(r"^\s*\d+\.\s+", nxt)
                or ("|" in nxt and i + 1 < n and _TABLE_SEP_RE.match(lines[i + 1]))
            ):
                break
            para.append(nxt)
            i += 1
        out.append(f"<p>{_render_inline(chr(10).join(para), token)}</p>")

    return "\n".join(out)


_TB_CELL_RE = re.compile(r"Cell\s+In\[(\d+)\],\s*line\s+(\d+)")
_TB_FILE_RE = re.compile(r'File\s+"([^"]+)",\s*line\s+(\d+)')


def render_traceback(text: str, own_index: int | None = None) -> str:
    """Render Python/IPython traceback with clickable jump buttons for frames."""
    lines = apply_carriage_returns(text).split("\n")
    rendered: list[str] = []
    own_attr = f' data-own-index="{own_index}"' if own_index is not None else ""

    for line in lines:
        plain = strip_ansi(line)
        line_html = ansi_to_html(line)
        cm = _TB_CELL_RE.search(plain)
        if cm:
            ec, ln = cm.group(1), cm.group(2)
            rendered.append(
                f'<button type="button" class="tb-jump" data-kind="cell" '
                f'data-exec-count="{ec}" data-line="{ln}"{own_attr}>{line_html}</button>'
            )
            continue
        fm = _TB_FILE_RE.search(plain)
        if fm:
            fpath, ln = fm.group(1), fm.group(2)
            rendered.append(
                f'<button type="button" class="tb-jump" data-kind="file" '
                f'data-path="{html.escape(fpath, quote=True)}" data-line="{ln}">{line_html}</button>'
            )
            continue
        rendered.append(line_html)

    joined = "\n".join(rendered)
    return f'<pre class="output error">{joined}</pre>'


def _wrap_tables(safe_html: str) -> str:
    if "<table" not in safe_html.lower():
        return safe_html
    return re.sub(
        r"(<table\b.*?</table>)",
        r'<div class="table-scroll">\1</div>',
        safe_html,
        flags=re.IGNORECASE | re.DOTALL,
    )


def _join_text(val: Any) -> str:
    if isinstance(val, list):
        return "".join(str(x) for x in val)
    return str(val or "")


def render_output(output: dict[str, Any], own_index: int, token: str = "") -> str:
    otype = output.get("output_type", "")
    if otype == "stream":
        name = output.get("name", "stdout")
        if name not in ("stdout", "stderr"):
            name = "stdout"
        text = apply_carriage_returns(_join_text(output.get("text", "")))
        return f'<pre class="output stream stream-{name}">{ansi_to_html(text)}</pre>'

    if otype == "error":
        tb = output.get("traceback")
        if tb:
            raw = "\n".join(str(x) for x in tb)
        else:
            raw = f"{output.get('ename', 'Error')}: {output.get('evalue', '')}"
        return render_traceback(raw, own_index=own_index)

    if otype in ("execute_result", "display_data"):
        data = output.get("data") or {}
        if "image/png" in data:
            b64 = _join_text(data["image/png"]).strip()
            src = f"data:image/png;base64,{b64}"
            return f'<a class="output img-link" href="{src}" target="_blank"><img src="{src}" alt="plot"></a>'
        if "image/jpeg" in data:
            b64 = _join_text(data["image/jpeg"]).strip()
            src = f"data:image/jpeg;base64,{b64}"
            return f'<a class="output img-link" href="{src}" target="_blank"><img src="{src}" alt="image"></a>'
        if "image/svg+xml" in data:
            svg_raw = _join_text(data["image/svg+xml"]).encode("utf-8")
            b64 = base64.b64encode(svg_raw).decode("ascii")
            src = f"data:image/svg+xml;base64,{b64}"
            return f'<a class="output img-link" href="{src}" target="_blank"><img src="{src}" alt="svg"></a>'
        if "text/html" in data:
            safe = _wrap_tables(sanitize_html(_join_text(data["text/html"])))
            return f'<div class="output rich-html">{safe}</div>'
        if "text/markdown" in data:
            return f'<div class="output rich-md">{render_markdown(_join_text(data["text/markdown"]), token)}</div>'
        if "text/latex" in data:
            return f'<div class="output rich-math">{render_math(_join_text(data["text/latex"]), display=True)}</div>'
        if "text/plain" in data:
            text = apply_carriage_returns(_join_text(data["text/plain"]))
            return f'<pre class="output plain">{ansi_to_html(text)}</pre>'

    return ""


def _format_stale_label(stale_info: dict[str, Any]) -> str:
    reasons = stale_info.get("reasons") or []
    parts: list[str] = []
    for r in reasons:
        if r.get("kind") == "edited":
            parts.append("edited")
        else:
            syms = ", ".join(r.get("symbols") or [])
            src = r.get("from", 0) + 1
            parts.append(f"← #{src}: {syms}" if syms else f"← #{src}")
    return f"⚠ stale ({'; '.join(parts)})" if parts else "⚠ stale"


def render_cell_html(
    cell: dict[str, Any],
    stale_info: dict[str, Any] | None = None,
    *,
    token: str = "",
    report: bool = False,
    active: bool = False,
    export: bool = False,
) -> str:
    idx = int(cell.get("index", 0))
    cell_type = cell.get("cell_type", "code")
    source = _join_text(cell.get("source", ""))

    classes = ["cell", f"cell-{cell_type}"]
    if active:
        classes.append("active")
    if stale_info and not report:
        classes.append("stale")

    if cell_type == "markdown":
        body = render_markdown(source, token=token)
        return f'<section id="cell-{idx}" class="{" ".join(classes)}" data-index="{idx}">{body}</section>'

    if cell_type == "raw":
        body = f'<pre class="raw">{html.escape(source)}</pre>'
        return f'<section id="cell-{idx}" class="{" ".join(classes)}" data-index="{idx}">{body}</section>'

    # Code cell
    status = cell.get("status", "idle")
    has_error = bool(cell.get("has_error", False))
    ec = cell.get("execution_count")
    duration_ms = cell.get("duration_ms")
    outputs = cell.get("outputs") or []

    parts: list[str] = []
    if not report:
        ec_label = f"[{ec}]" if ec is not None else "[ ]"
        badge = ""
        if status == "busy":
            badge = '<span class="badge badge-busy">● running</span>'
        elif has_error:
            badge = '<span class="badge badge-err">✗ error</span>'
        elif stale_info:
            badge = f'<span class="badge badge-stale">{html.escape(_format_stale_label(stale_info))}</span>'
        elif ec is not None:
            badge = '<span class="badge badge-ok">✓</span>'

        dur = f"<span>{duration_ms / 1000:.1f}s</span>" if isinstance(duration_ms, (int, float)) else ""
        interrupt = (
            '<button type="button" class="interrupt-btn" title="Interrupt kernel">■</button>'
            if status == "busy" and not export
            else ""
        )
        parts.append(
            f'<div class="cell-header"><span>#{idx + 1}</span><span>{ec_label}</span>'
            f"{badge}{dur}{interrupt}</div>"
        )
        parts.append(f'<div class="cell-input">{highlight_code(source, "python")}</div>')

    rendered_outputs = [
        rendered
        for out in outputs
        if (rendered := render_output(out, own_index=idx, token=token))
    ]
    if rendered_outputs:
        parts.append(f'<div class="cell-outputs">{"".join(rendered_outputs)}</div>')

    if report and not rendered_outputs:
        return ""

    return f'<section id="cell-{idx}" class="{" ".join(classes)}" data-index="{idx}">{"".join(parts)}</section>'


def render_document(
    cells: list[dict[str, Any]],
    stale_map: dict[int, dict[str, Any]] | None = None,
    title: str = "Notebook",
    *,
    report: bool = False,
    export: bool = False,
    token: str = "",
    active_index: int | None = None,
) -> str:
    """Render full standalone HTML document from page.html template."""
    with open(_TEMPLATE_PATH, "r", encoding="utf-8") as fh:
        template = fh.read()

    stale_map = stale_map or {}
    cell_fragments: list[str] = []
    for idx, cell in enumerate(cells):
        c = dict(cell)
        c.setdefault("index", idx)
        frag = render_cell_html(
            c,
            stale_map.get(idx),
            token=token,
            report=report,
            active=(active_index == idx),
            export=export,
        )
        if frag:
            cell_fragments.append(frag)

    if export:
        doc = re.sub(r"<!--LIVE_BAR-->.*?<!--/LIVE_BAR-->\s*", "", template, flags=re.DOTALL)
        doc = re.sub(r"<!--LIVE_SCRIPT-->.*?<!--/LIVE_SCRIPT-->\s*", "", doc, flags=re.DOTALL)
    else:
        qtok = urllib.parse.quote(token, safe="")
        doc = template.replace("<!--LIVE_BAR-->", "").replace("<!--/LIVE_BAR-->", "")
        doc = doc.replace("<!--LIVE_SCRIPT-->", "").replace("<!--/LIVE_SCRIPT-->", "")
        doc = doc.replace("{{TOKEN_URL}}", qtok)
        doc = doc.replace("{{TOKEN_JSON}}", json.dumps(token))

    doc = doc.replace("{{TITLE}}", html.escape(title))
    doc = doc.replace("{{PYGMENTS_CSS}}", pygments_css())
    doc = doc.replace("{{CELLS}}", "\n".join(cell_fragments))
    return doc
