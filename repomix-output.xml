<script>
(()=>{
const T={{TOKEN_JSON}},$=id=>document.getElementById(id),nb=$("notebook"),dot=$("conn-dot"),sf=$("stdin-form"),sp=$("stdin-prompt"),si=$("stdin-in");
const q=encodeURIComponent(T),post=b=>fetch("/action?token="+q,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(b)});
const es=new EventSource("/events?token="+q);
es.onopen=()=>dot&&dot.classList.remove("off");
es.onerror=()=>dot&&dot.classList.add("off");
es.addEventListener("full",e=>{nb.innerHTML=e.data;});
es.addEventListener("cell",e=>{const d=JSON.parse(e.data),el=$("cell-"+d.index);if(el)el.outerHTML=d.html;});
es.addEventListener("cursor",e=>{const d=JSON.parse(e.data);nb.querySelectorAll(".cell.active").forEach(c=>c.classList.remove("active"));const el=$("cell-"+d.index);if(el){el.classList.add("active");el.scrollIntoView({block:"nearest"});}});
es.addEventListener("stdin",e=>{const d=JSON.parse(e.data);sp.textContent=d.prompt||"Input:";si.type=d.password?"password":"text";si.value="";sf.classList.add("open");si.focus();});
es.addEventListener("print",()=>window.print());
es.addEventListener("shutdown",()=>{es.close();dot&&dot.classList.add("off");});
sf.addEventListener("submit",e=>{e.preventDefault();sf.classList.remove("open");post({action:"stdin",value:si.value});});
nb.addEventListener("click",e=>{const b=e.target.closest(".tb-jump,.interrupt-btn");if(!b)return;if(b.classList.contains("interrupt-btn"))return post({action:"interrupt"});const s=b.dataset;post({action:"jump",kind:s.kind,cell:s.cell?+s.cell:null,exec_count:s.execCount?+s.execCount:null,own_index:s.ownIndex?+s.ownIndex:null,path:s.path||null,line:s.line?+s.line:1});});
const pb=$("present-btn");if(pb)pb.onclick=()=>document.body.classList.toggle("present");
})();
</script>
