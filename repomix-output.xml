  end)

  it("jumps directly when given a valid target", function()
    make_buffer(lines)
    vim.api.nvim_win_set_cursor(0, { 2, 0 })
    M.jump_to_cell(3)
    assert.are.equal(8, vim.api.nvim_win_get_cursor(0)[1])
  end)

  it("warns instead of prompting on explicit invalid targets (0, -1, 'foo')", function()
    make_buffer(lines)
    vim.api.nvim_win_set_cursor(0, { 2, 0 })
    local prompted = false
    local warnings = {}
    local orig_input = vim.ui.input
    local orig_notify = vim.notify
    vim.ui.input = function()
      prompted = true
    end
    vim.notify = function(msg)
      table.insert(warnings, msg)
    end

    M.jump_to_cell(0)
    M.jump_to_cell(-1)
    M.jump_to_cell("foo")

    vim.ui.input = orig_input
    vim.notify = orig_notify

    assert.is_false(prompted)
    assert.are.equal(3, #warnings)
    assert.are.equal(2, vim.api.nvim_win_get_cursor(0)[1])
  end)
end)

describe("M.open / M.close regressions", function()
  before_each(function()
    M.close()
    requests = {}
    server_start_calls = 0
  end)

  after_each(function()
    M.close()
  end)

  it("clears buffer-local autocmds on M.close() so deleting an old buffer cannot kill a new session", function()
    local first = make_buffer({ "# %%", "x = 1" }, vim.fn.tempname() .. ".ipynb")
    M.open()
    last_start_opts.on_ready()
    assert.is_true(session.is_active())
    M.close()

    local second = make_buffer({ "# %%", "y = 2" }, vim.fn.tempname() .. ".ipynb")
    M.open()
    last_start_opts.on_ready()
    assert.is_true(session.is_active())
    assert.are.equal(second, session.bufnr)

    -- Deleting the FIRST buffer must NOT close the SECOND buffer's active preview!
    vim.api.nvim_buf_delete(first, { force = true })
    assert.is_true(session.is_active())
    assert.are.equal(second, session.bufnr)
  end)

  it("does not trigger render on BufEnter (prevents closing floats from clobbering live edits)", function()
    local bufnr = make_buffer({ "# %%", "x = 1" }, vim.fn.tempname() .. ".ipynb")
    M.open()
    last_start_opts.on_ready()
    requests = {}

    vim.api.nvim_exec_autocmds("BufEnter", { buffer = bufnr })
    for _, req in ipairs(requests) do
      assert.are_not.equal("render", req.cmd)
    end
  end)

  it("M.run_affected and M.run_slice query DAG and run returned cell indices sequentially", function()
    local bufnr = make_buffer({ "# %%", "a = 1", "# %%", "b = 2", "# %%", "c = a + 3" }, vim.fn.tempname() .. ".ipynb")
    M.open()
    last_start_opts.on_ready()
    requests = {}

    vim.api.nvim_win_set_cursor(0, { 2, 0 })
    M.run_affected()
    assert.are.equal(1, #requests)
    assert.are.equal("dag_query", requests[1].cmd)
    assert.are.equal("affected", requests[1].fields.kind)
    assert.are.equal(0, requests[1].fields.index)

    -- Simulate server returning affected slice [0, 2]
    requests[1].cb({ ok = true, indices = { 0, 2 } })
    assert.are.equal(2, #requests)
    assert.are.equal("execute", requests[2].cmd)
    assert.are.equal(0, requests[2].fields.index)

    -- Completing cell 0 advances to cell 2
    last_start_opts.on_event({ type = "cell_status", index = 0, status = "idle", execution_count = 1, has_error = false })
    assert.are.equal(3, #requests)
    assert.are.equal("execute", requests[3].cmd)
    assert.are.equal(2, requests[3].fields.index)

    -- Test run_slice on cell 2
    requests = {}
    vim.api.nvim_win_set_cursor(0, { 6, 0 })
    M.run_slice()
    assert.are.equal(1, #requests)
    assert.are.equal("dag_query", requests[1].cmd)
    assert.are.equal("upstream", requests[1].fields.kind)
    assert.are.equal(2, requests[1].fields.index)
    requests[1].cb({ ok = true, indices = { 0, 2 } })
    assert.are.equal("execute", requests[2].cmd)
    assert.are.equal(0, requests[2].fields.index)
  end)

  it("rejects a second notebook while one preview is open", function()
    local first = make_buffer({ "# %%", "1" }, vim.fn.tempname() .. ".ipynb")
    M.open()
    local _ = make_buffer({ "# %%", "2" }, vim.fn.tempname() .. ".ipynb")
    local notifications = {}
    local orig_notify = vim.notify
    vim.notify = function(msg)
      table.insert(notifications, msg)
    end
    M.open()
    vim.notify = orig_notify
    assert.are.equal(1, server_start_calls)
    assert.is_truthy(notifications[1]:find("already open for another notebook", 1, true))
    assert.are.equal(first, session.bufnr)
  end)

  it("tears down cleanly on unexpected server exit while active", function()
    make_buffer({ "# %%", "1" }, vim.fn.tempname() .. ".ipynb")
    M.open()
    last_start_opts.on_ready()
    assert.is_true(session.is_active())

    last_start_opts.on_exit()
    assert.are.equal("idle", session.state)
  end)
end)
