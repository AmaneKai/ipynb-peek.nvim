--- Notebook outline: markdown headings plus one row per code cell, shown in a
--- floating window. Selecting a row jumps to that cell in the buffer.
local cells = require("ipynb-peek.cells")
local float = require("ipynb-peek.float")
local runtime = require("ipynb-peek.runtime")
local session = require("ipynb-peek.session")

local M = {}

local ICONS = { busy = "●", error = "✗", stale = "~", ok = "✓", idle = "○" }

--- Headings (level, title) of one markdown cell's text, skipping code fences.
function M.headings(text)
  local found = {}
  local fenced = false
  for line in (text .. "\n"):gmatch("(.-)\n") do
    if line:match("^%s*```") or line:match("^%s*~~~") then
      fenced = not fenced
    elseif not fenced then
      local hashes, title = line:match("^(#+)%s+(.-)%s*#*%s*$")
      if hashes and #hashes <= 6 and title ~= "" then
        table.insert(found, { level = #hashes, title = title })
      end
    end
  end
  return found
end

local function truncate_utf8(text, max_chars)
  if vim.fn.strchars(text) <= max_chars then
    return text
  end
  return vim.fn.strcharpart(text, 0, max_chars - 1) .. "…"
end

local function first_line(source)
  for line in (source .. "\n"):gmatch("(.-)\n") do
    local trimmed = vim.trim(line)
    if trimmed ~= "" then
      return truncate_utf8(trimmed, 60)
    end
  end
  return "(empty)"
end

local function code_status(info, stale_info)
  if info and info.status == "busy" then
    return "busy"
  end
  if info and info.has_error then
    return "error"
  end
  if stale_info then
    return "stale"
  end
  if info and info.execution_count ~= nil and info.execution_count ~= vim.NIL then
    return "ok"
  end
  return "idle"
end

--- Rows for the outline. `lines` is the buffer snapshot; `statuses` and
--- `stale_map` map 0-based cell indices to status/staleness (may be empty).
function M.entries(parsed, lines, statuses, stale_map)
  statuses = statuses or {}
  stale_map = stale_map or {}
  local rows = {}
  local depth = 0
  for i, cell in ipairs(parsed) do
    if cell.cell_type == "markdown" then
      local text = cells.display_source_from_lines(lines, cell)
      for _, heading in ipairs(M.headings(text)) do
        depth = heading.level
        table.insert(rows, {
          line = cell.start_line,
          index = i - 1,
          text = string.rep("  ", heading.level - 1) .. heading.title,
        })
      end
    elseif cell.cell_type == "code" then
      local idx = i - 1
      local info = statuses[idx]
      local stale_info = stale_map[idx]
      local count = info and info.execution_count
      local label = (count ~= nil and count ~= vim.NIL) and tostring(count) or " "
      local suffix = (stale_info and not (info and info.has_error) and not (info and info.status == "busy"))
          and "  ⚠ stale"
        or ""
      table.insert(rows, {
        line = cell.start_line,
        index = idx,
        text = string.format(
          "%s%s [%s] %s%s",
          string.rep("  ", math.min(depth, 6)),
          ICONS[code_status(info, stale_info)],
          label,
          first_line(cells.source_from_lines(lines, cell)),
          suffix
        ),
      })
    end
  end
  return rows
end

function M.open(bufnr)
  bufnr = bufnr or vim.api.nvim_get_current_buf()
  local parsed, lines = cells.snapshot(bufnr)
  local same_session = session.is_active() and session.bufnr == bufnr
  local statuses = same_session and runtime.cells or {}
  local stale_map = same_session and runtime.stale or {}
  local rows = M.entries(parsed, lines, statuses, stale_map)
  if #rows == 0 then
    vim.notify("[ipynb-peek] no cells to show", vim.log.levels.INFO)
    return
  end

  local current = 1
  local cursor_line = vim.api.nvim_win_get_cursor(0)[1]
  local here = cells.cell_index_at(parsed, cursor_line)
  for i, row in ipairs(rows) do
    if here ~= nil and row.index <= here then
      current = i
    end
  end

  local texts = {}
  for i, row in ipairs(rows) do
    texts[i] = row.text
  end
  local origin = vim.api.nvim_get_current_win()
  float.open({
    title = "Notebook outline",
    lines = texts,
    cursor_line = current,
    on_select = function(selected)
      local row = rows[selected]
      if not row then
        return
      end
      if not vim.api.nvim_win_is_valid(origin) or vim.api.nvim_win_get_buf(origin) ~= bufnr then
        return
      end
      vim.api.nvim_set_current_win(origin)
      local target = math.min(row.line + 1, vim.api.nvim_buf_line_count(bufnr))
      vim.api.nvim_win_set_cursor(origin, { target, 0 })
      vim.cmd("normal! zz")
    end,
  })
end

return M
</file>

<file path="lua/ipynb-peek/runtime.lua">
--- Execution & DAG staleness state reported by the server, kept apart from
--- session lifecycle (session.lua) and buffer state so text-objects, outline,
--- status signs, and statusline can read it cleanly.
local M = {}

local uv = vim.uv or vim.loop

--- 0-based cell index -> { status, execution_count, duration_ms, has_error }
M.cells = {}
--- 0-based cell index -> uv.now() when it was last seen turning busy
M.busy_since = {}
--- 0-based cell index -> { edited = bool, reasons = [{ from, symbols, kind }] }
M.stale = {}
--- { name = string|nil, running = boolean }
M.kernel = { name = nil, running = false }

function M.reset()
  M.cells = {}
  M.busy_since = {}
  M.stale = {}
  M.kernel = { name = nil, running = false }
end

function M.set_cell(info)
  local previous = M.cells[info.index]
  M.cells[info.index] = info
  if info.status == "busy" then
    if not previous or previous.status ~= "busy" then
      M.busy_since[info.index] = uv.now()
    end
  else
    M.busy_since[info.index] = nil
  end
end

function M.set_all(list)
  local busy_since = M.busy_since
  M.cells = {}
  M.busy_since = {}
  for _, info in ipairs(list) do
    M.cells[info.index] = info
    if info.status == "busy" then
      M.busy_since[info.index] = busy_since[info.index] or uv.now()
    end
  end
end

--- Replaces the stale map (accepts numeric or string keys from JSON).
function M.set_stale(stale_map)
  M.stale = {}
  if type(stale_map) ~= "table" then
    return
  end
  for k, v in pairs(stale_map) do
    local idx = tonumber(k)
    if idx ~= nil and type(v) == "table" then
      M.stale[idx] = v
    end
  end
end

function M.is_stale(index)
  return M.stale[index] ~= nil
end

function M.stale_count()
  local count = 0
  for _ in pairs(M.stale) do
    count = count + 1
  end
  return count
end

function M.set_kernel(info)
  M.kernel = { name = info.name, running = info.running == true }
end

function M.busy()
  local oldest_index, oldest_since
  for index, since in pairs(M.busy_since) do
    if not oldest_since or since < oldest_since then
      oldest_index, oldest_since = index, since
    end
  end
  if oldest_index == nil then
    return nil
  end
  return oldest_index, uv.now() - oldest_since
end

function M.has_error(index)
  local info = M.cells[index]
  return info ~= nil and info.has_error == true
end

return M
</file>

<file path="lua/ipynb-peek/session.lua">
--- Lifecycle of the (single) preview session as an explicit state machine, so
--- "is it safe to send a command right now" has one answer instead of being
--- inferred from several flags:
---
---   idle -> starting -> active -> stopping -> idle
---              \          \
---               +----------+--> error -> stopping -> idle
---
--- Every begin() hands out a fresh id. Async callbacks (server ready, events,
--- timers) capture the id they were created under and drop themselves via
--- is_current() once the session they belonged to is gone - a stale callback
--- from a closed preview can never act on a later one.
---
--- Pure state: touches no buffers, processes, or timers.
local M = {}

local TRANSITIONS = {
  idle = { starting = true },
  starting = { active = true, error = true, stopping = true },
  active = { error = true, stopping = true },
  error = { stopping = true },
  stopping = { idle = true },
}

M.state = "idle"
M.id = 0
M.bufnr = nil
--- Why the session last entered "error" (kept after returning to idle so
--- :checkhealth / bug reports can see it); cleared by the next begin().
M.error = nil

local function transition(to)
  assert(TRANSITIONS[M.state][to], ("invalid session transition %s -> %s"):format(M.state, to))
  M.state = to
end

--- idle -> starting. Returns the new session id, or nil and a reason when a
--- session already exists (callers show the reason; there is one global
--- server/kernel, so a second notebook cannot be previewed concurrently).
function M.begin(bufnr)
  if M.state ~= "idle" then
    return nil, M.bufnr == bufnr and "same-buffer" or "other-buffer"
  end
  transition("starting")
  M.id = M.id + 1
  M.bufnr = bufnr
  M.error = nil
  return M.id
end

--- starting -> active. False (and no change) if `id` is no longer current.
function M.activate(id)
  if not M.is_current(id) or M.state ~= "starting" then
    return false
  end
  transition("active")
  return true
end

--- starting|active -> error. False if `id` is stale or already past that.
function M.fail(id, message)
  if not M.is_current(id) or (M.state ~= "starting" and M.state ~= "active") then
    return false
  end
  transition("error")
  M.error = message
  return true
end

--- Any live state -> stopping -> idle. Returns the buffer the session belonged
--- to (nil if there was none), so the caller can clean it up.
function M.finish()
  if M.state == "idle" then
    return nil
  end
  local bufnr = M.bufnr
  transition("stopping")
  M.bufnr = nil
  transition("idle")
  return bufnr
end

function M.is_active()
  return M.state == "active"
end

--- True while `id` still identifies the live session.
function M.is_current(id)
  return id == M.id and M.state ~= "idle" and M.state ~= "stopping"
end

--- Test helper: back to a pristine idle session.
function M._reset()
  M.state = "idle"
  M.id = 0
  M.bufnr = nil
  M.error = nil
end

return M
</file>

<file path="lua/ipynb-peek/status.lua">
--- Pure formatting for in-buffer cell status sign/virtual text (execution + DAG staleness).
local M = {}

local function has_execution_count(status_info)
  return status_info ~= nil
    and status_info.execution_count ~= nil
    and status_info.execution_count ~= vim.NIL
end

local function format_stale_reasons(stale_info)
  local reasons = stale_info and stale_info.reasons or {}
  local parts = {}
  for _, r in ipairs(reasons) do
    if r.kind == "edited" then
      table.insert(parts, "edited")
    else
      local from_num = (r.from or 0) + 1
      local syms = type(r.symbols) == "table" and table.concat(r.symbols, ", ") or ""
      if syms ~= "" then
        table.insert(parts, string.format("← #%d: %s", from_num, syms))
      else
        table.insert(parts, string.format("← #%d", from_num))
      end
    end
  end
  if #parts == 0 then
    return "⚠ stale"
  end
  return "⚠ stale (" .. table.concat(parts, "; ") .. ")"
end

--- Returns { sign_text, hl_group } for a cell's status & staleness, or nil.
function M.icon_for(status_info, stale_info)
  status_info = status_info or {}
  if status_info.status == "busy" then
    return { sign_text = "●", hl_group = "DiagnosticWarn" }
  end
  if status_info.has_error then
    return { sign_text = "✗", hl_group = "DiagnosticError" }
  end
  if stale_info then
    return { sign_text = "~", hl_group = "DiagnosticWarn" }
  end
  if has_execution_count(status_info) then
    return { sign_text = "✓", hl_group = "DiagnosticOk" }
  end
  return nil
end

--- Returns virtual text shown at the end of a cell's marker line, e.g.:
---   "  [2] 0.4s  ⚠ stale (← #1: lr)"
function M.virt_text_for(status_info, stale_info)
  status_info = status_info or {}
  if status_info.status == "busy" then
    return ""
  end
  local text = ""
  if has_execution_count(status_info) then
    text = "  [" .. status_info.execution_count .. "]"
    if status_info.duration_ms ~= nil and status_info.duration_ms ~= vim.NIL then
      text = text .. " " .. string.format("%.1fs", status_info.duration_ms / 1000)
    end
  end
  if stale_info and not status_info.has_error then
    text = text .. "  " .. format_stale_reasons(stale_info)
  end
  return text
end

return M
</file>

<file path="lua/ipynb-peek/statusline.lua">
--- Statusline component for lualine / heirline / plain 'statusline'.
local session = require("ipynb-peek.session")
local runtime = require("ipynb-peek.runtime")

local M = {}

local uv = vim.uv or vim.loop
local redraw_timer = nil

--- Pure formatting. `state`: { active, name, running, busy_ms, stale_count }.
function M.format(state)
  if not state.active then
    return ""
  end
  local name = state.name or "kernel"
  if state.busy_ms ~= nil then
    return string.format("● %s (busy: %.1fs)", name, state.busy_ms / 1000)
  end
  local stale = state.stale_count or 0
  local stale_suffix = stale > 0 and string.format(", %d stale", stale) or ""
  if state.running then
    return string.format("○ %s (idle%s)", name, stale_suffix)
  end
  return string.format("◌ %s (not started%s)", name, stale_suffix)
end

local function stop_timer(timer)
  if timer and not timer:is_closing() then
    timer:stop()
    timer:close()
  end
  if redraw_timer == timer then
    redraw_timer = nil
  end
end

local function ensure_redraw_timer(busy)
  if busy and not redraw_timer then
    local timer = uv.new_timer()
    redraw_timer = timer
    timer:start(1000, 1000, function()
      vim.schedule(function()
        if not timer or timer:is_closing() then
          return
        end
        if runtime.busy() == nil or not session.is_active() then
          stop_timer(timer)
        end
        vim.cmd.redrawstatus()
      end)
    end)
  elseif not busy and redraw_timer then
    stop_timer(redraw_timer)
  end
end

function M.kernel_status()
  local active = session.is_active()
  local _, busy_ms = runtime.busy()
  ensure_redraw_timer(active and busy_ms ~= nil)
  return M.format({
    active = active,
    name = runtime.kernel.name,
    running = runtime.kernel.running,
    busy_ms = busy_ms,
    stale_count = runtime.stale_count(),
  })
end

function M.is_active()
  return session.is_active()
end

return M
</file>

<file path="lua/ipynb-peek/textobjects.lua">
--- Vim-native cell text-objects and motions over the `# %%` buffer view:
---   ic / ac   inside (body) / around (marker + body) the current cell
---   ]c / [c   next / previous cell marker
---   ]e / [e   next / previous cell whose last run errored
---   ]s / [s   next / previous stale cell
local cells = require("ipynb-peek.cells")
local runtime = require("ipynb-peek.runtime")

local M = {}

M.defaults = {
  inner = "ic",
  around = "ac",
  next_cell = "]c",
  prev_cell = "[c",
  next_error = "]e",
  prev_error = "[e",
  next_stale = "]s",
  prev_stale = "[s",
}

function M.range(cell, kind)
  if kind == "around" then
    return cell.start_line, cell.end_line
  end
  if cell.end_line <= cell.start_line then
    return nil
  end
  return cell.start_line + 1, cell.end_line
end

function M.boundary_target(parsed, line, direction)
  if direction == "next" then
    for _, cell in ipairs(parsed) do
      if cell.start_line > line then
        return cell.start_line
      end
    end
    return nil
  end
  local target
  for _, cell in ipairs(parsed) do
    if cell.start_line < line then
      target = cell.start_line
    end
  end
  return target
end

local function scan_target(parsed, line, direction, predicate)
  local current = cells.cell_index_at(parsed, line)
  if direction == "next" then
    for index = (current or -1) + 1, #parsed - 1 do
      if predicate(index) then
        return parsed[index + 1].start_line
      end
    end
  else
    for index = (current or #parsed) - 1, 0, -1 do
      if predicate(index) then
        return parsed[index + 1].start_line
      end
    end
  end
  return nil
end

function M.error_target(parsed, line, direction, has_error)
  return scan_target(parsed, line, direction, has_error)
end

function M.stale_target(parsed, line, direction, is_stale)
  return scan_target(parsed, line, direction, is_stale)
end

local function leave_visual_if_needed()
  local mode = vim.fn.mode()
  if mode == "v" or mode == "V" or mode == "\22" then
    vim.cmd("normal! \27")
  end
end

function M.select(kind)
  local bufnr = vim.api.nvim_get_current_buf()
  local line = vim.api.nvim_win_get_cursor(0)[1]
  local parsed = cells.parse(bufnr)
  local _, cell = cells.cell_index_at(parsed, line)
  if not cell then
    return
  end
  local first, last = M.range(cell, kind)
  if not first then
    return
  end
  leave_visual_if_needed()
  vim.cmd(string.format("normal! %dGV%dG", first, last))
end

function M.jump(direction)
  local bufnr = vim.api.nvim_get_current_buf()
  for _ = 1, vim.v.count1 do
    local line = vim.api.nvim_win_get_cursor(0)[1]
    local next_line = M.boundary_target(cells.parse(bufnr), line, direction)
    if not next_line then
      break
    end
    vim.api.nvim_win_set_cursor(0, { next_line, 0 })
  end
end

function M.jump_error(direction)
  local bufnr = vim.api.nvim_get_current_buf()
  local line = vim.api.nvim_win_get_cursor(0)[1]
  local target = M.error_target(cells.parse(bufnr), line, direction, runtime.has_error)
  if target then
    vim.api.nvim_win_set_cursor(0, { target, 0 })
  else
    vim.notify("[ipynb-peek] no " .. direction .. " cell with an error", vim.log.levels.INFO)
  end
end

function M.jump_stale(direction)
  local bufnr = vim.api.nvim_get_current_buf()
  local line = vim.api.nvim_win_get_cursor(0)[1]
  local target = M.stale_target(cells.parse(bufnr), line, direction, runtime.is_stale)
  if target then
    vim.api.nvim_win_set_cursor(0, { target, 0 })
  else
    vim.notify("[ipynb-peek] no " .. direction .. " stale cell", vim.log.levels.INFO)
  end
end

function M.apply(bufnr, keys)
  keys = vim.tbl_extend("force", M.defaults, keys or {})
  local function map(modes, lhs, fn, desc)
    if lhs then
      vim.keymap.set(modes, lhs, fn, { buffer = bufnr, desc = "ipynb-peek: " .. desc })
    end
  end
  map({ "x", "o" }, keys.inner, function()
    M.select("inner")
  end, "inside cell")
  map({ "x", "o" }, keys.around, function()
    M.select("around")
  end, "around cell")
  for direction, lhs in pairs({ next = keys.next_cell, prev = keys.prev_cell }) do
    map({ "n", "x" }, lhs, function()
      if vim.wo.diff then
        vim.cmd("normal! " .. vim.v.count1 .. lhs)
        return
      end
      M.jump(direction)
    end, direction .. " cell")
  end
  map({ "n", "x" }, keys.next_error, function()
    M.jump_error("next")
  end, "next cell with error")
  map({ "n", "x" }, keys.prev_error, function()
    M.jump_error("prev")
  end, "previous cell with error")
  map({ "n", "x" }, keys.next_stale, function()
    M.jump_stale("next")
  end, "next stale cell")
  map({ "n", "x" }, keys.prev_stale, function()
    M.jump_stale("prev")
  end, "previous stale cell")
end

return M
</file>

<file path="lua/ipynb-peek/variables.lua">
--- Formatting for the kernel variable inspector.
local float = require("ipynb-peek.float")

local M = {}

function M.format_bytes(bytes)
  if bytes == nil or bytes == vim.NIL then
    return ""
  end
  if bytes < 1024 then
    return bytes .. " B"
  end
  local units = { "KB", "MB", "GB", "TB" }
  local value, unit = bytes, 0
  repeat
    value = value / 1024
    unit = unit + 1
  until value < 1024 or unit == #units
  return string.format(value >= 100 and "%.0f %s" or "%.1f %s", value, units[unit])
end

local function sanitize_single_line(text)
  return tostring(text or ""):gsub("[\r\n]+", " ")
end

--- UTF-8 and display-width safe truncation with ellipsis.
function M.truncate_display(text, max_width)
  text = sanitize_single_line(text)
  if vim.fn.strdisplaywidth(text) <= max_width then
    return text
  end
  local budget = math.max(0, max_width - 1)
  local chars = vim.fn.strchars(text)
  local out = ""
  local width = 0
  for i = 0, chars - 1 do
    local ch = vim.fn.strcharpart(text, i, 1)
    local cw = vim.fn.strdisplaywidth(ch)
    if width + cw > budget then
      break
    end
    out = out .. ch
    width = width + cw
  end
  return out .. "…"
end

local function pad(text, width)
  local gap = width - vim.fn.strdisplaywidth(text)
  return text .. string.rep(" ", math.max(0, gap))
end

--- Aligned table lines for `rows` (server shape: name/type/shape/size_bytes/preview).
function M.format_rows(rows)
  local header = { "Name", "Type", "Shape / size", "Memory", "Preview" }
  local body, total = {}, 0
  for _, row in ipairs(rows) do
    if type(row.size_bytes) == "number" then
      total = total + row.size_bytes
    end
    table.insert(body, {
      sanitize_single_line(row.name),
      sanitize_single_line(row.type),
      sanitize_single_line(row.shape),
      M.format_bytes(row.size_bytes),
      M.truncate_display(row.preview or "", 60),
    })
  end

  local widths = {}
  for column, title in ipairs(header) do
    widths[column] = vim.fn.strdisplaywidth(title)
    for _, cells_ in ipairs(body) do
      widths[column] = math.max(widths[column], vim.fn.strdisplaywidth(cells_[column]))
    end
  end
  widths[5] = math.min(widths[5], 60)

  local function line(cells_)
    local parts = {}
    for column = 1, 5 do
      parts[column] = pad(cells_[column], widths[column])
    end
    return (table.concat(parts, "  "):gsub("%s+$", ""))
  end

  local lines = { line(header) }
  table.insert(lines, string.rep("─", vim.fn.strdisplaywidth(lines[1])))
  for _, cells_ in ipairs(body) do
    table.insert(lines, line(cells_))
  end
  table.insert(lines, "")
  table.insert(
    lines,
    string.format(
      "%d variables, ~%s (shallow sizes for plain Python objects)",
      #rows,
      M.format_bytes(total)
    )
  )
  return lines
end

function M.show(rows)
  if #rows == 0 then
    vim.notify("[ipynb-peek] the kernel has no user variables yet", vim.log.levels.INFO)
    return
  end
  float.open({ title = "Kernel variables", lines = M.format_rows(rows), max_width = 140 })
end

return M
</file>

