<file path="lua/ipynb-peek/health.lua">
local M = {}
local health = vim.health
local server = require("ipynb-peek.server")

local function get_config()
  local ok, plugin = pcall(require, "ipynb-peek")
  return ok and plugin.config or {}
end

local function check_python(cfg)
  local py = server.find_python(cfg.python)
  if not py then
    health.error("python3 not found on PATH", {
      "Install Python 3 or set `python = '/path/to/python3'` in setup()",
    })
    return nil
  end
  local ver = vim.trim(vim.fn.system({ py, "--version" }))
  if vim.v.shell_error ~= 0 then
    health.error("configured Python executable failed: " .. py)
    return nil
  end
  health.ok("Python found: " .. py .. " (" .. ver .. ")")
  return py
end

local function check_python_packages(py)
  local probe = [[
import json
res = {}
for mod in ("jupyter_client", "ipykernel", "pygments", "latex2mathml"):
    try:
        __import__(mod)
        res[mod] = True
    except Exception:
        res[mod] = False
res["kernels"] = []
if res["jupyter_client"]:
    try:
        from jupyter_client.kernelspec import KernelSpecManager
        res["kernels"] = sorted(KernelSpecManager().find_kernel_specs().keys())
    except Exception:
        pass
print(json.dumps(res))
]]
  local out = vim.fn.system({ py, "-c", probe })
  if vim.v.shell_error ~= 0 then
    health.warn("failed to inspect Python environment packages")
    return
  end
  local ok, info = pcall(vim.json.decode, out)
  if not ok or type(info) ~= "table" then
    health.warn("unexpected output probing Python environment")
    return
  end

  if info.jupyter_client then
    health.ok("jupyter_client is installed")
  else
    health.warn("jupyter_client not found in " .. py, {
      "Preview & AST DAG work without it, but code execution requires jupyter_client + ipykernel",
      "Install in your environment: pip install ipykernel",
    })
  end

  if info.ipykernel then
    health.ok("ipykernel is installed")
  else
    health.info("ipykernel not found in " .. py .. " (needed if running Python kernels from this env)")
  end

  if type(info.kernels) == "table" and #info.kernels > 0 then
    health.ok(#info.kernels .. " Jupyter kernel(s) available: " .. table.concat(info.kernels, ", "))
  elseif info.jupyter_client then
    health.warn("no Jupyter kernelspecs found", {
      "Register a kernel: " .. py .. " -m ipykernel install --user",
    })
  end

  if info.pygments then
    health.ok("pygments is installed (syntax highlighting enabled)")
  else
    health.info("pygments not installed (optional; preview falls back to plain-text code blocks)")
  end

  if info.latex2mathml then
    health.ok("latex2mathml is installed (native MathML rendering enabled)")
  else
    health.info("latex2mathml not installed (optional; preview falls back to styled TeX)")
  end
end

local function check_browser(cfg)
  local pref = cfg.browser
  if pref == false then
    health.ok("browser = false (headless / SSH mode: URL will be notified instead of opening a browser)")
  elseif pref == nil or pref == "default" then
    health.ok('browser = "default" (opens preview via vim.ui.open)')
  elseif type(pref) == "table" and type(pref[1]) == "string" then
    if vim.fn.executable(pref[1]) == 1 then
      health.ok("custom browser command found: " .. pref[1])
    else
      health.error("configured browser executable not found on PATH: " .. pref[1])
    end
  else
    health.warn("unrecognized `browser` config value: " .. vim.inspect(pref), {
      'Use "default", a command table like { "surf" }, or false for headless mode',
    })
  end
end

function M.check()
  health.start("ipynb-peek")
  local cfg = get_config()
  local py = check_python(cfg)
  if py then
    check_python_packages(py)
  end
  check_browser(cfg)
end

return M
</file>

<file path="lua/ipynb-peek/cells.lua">
local M = {}

local cached_bufnr = nil
local cached_changedtick = nil
local cached_cells = nil
local cached_lines = nil

--- Scans quoted tag strings inside `tags=[...]` in a single pass so mixed
--- quotes and embedded apostrophes/quotes preserve exact order and values.
local function parse_tags(line)
  local tags = {}
  local list = line:match("tags%s*=%s*%[(.-)%]")
  if not list then
    return tags
  end
  local i, len = 1, #list
  while i <= len do
    local ch = list:sub(i, i)
    if ch == '"' or ch == "'" then
      local j = i + 1
      local buf = {}
      while j <= len do
        local c = list:sub(j, j)
        if c == "\\" and j < len then
          table.insert(buf, list:sub(j + 1, j + 1))
          j = j + 2
        elseif c == ch then
          break
        else
          table.insert(buf, c)
          j = j + 1
        end
      end
      if j <= len then
        table.insert(tags, table.concat(buf))
      end
      i = j + 1
    else
      i = i + 1
    end
  end
  return tags
end

--- Extracts a marker-line boolean attribute (`editable=false` / `deletable=false`)
--- with strict word boundaries so `uneditable=false` does not match `editable=false`.
local function parse_bool_attr(line, name)
  return line:match("%f[%w_]" .. name .. "%s*=%s*false%f[^%w_]") == nil
end

--- Matches `# %%` or `#%%` only when followed by end-of-line or whitespace,
--- so IPython cell magics like `# %%timeit` or `# %%bash` do NOT split cells.
local function match_marker(line)
  if line:match("^# ?%%%%$") then
    return ""
  end
  return line:match("^# ?%%%%(%s.*)$")
end

--- Pure line-array parser (no buffer required). Returns an array of
--- { start_line, end_line, cell_type, tags, editable, deletable } (1-based inclusive).
function M.parse_lines(lines)
  local parsed = {}
  local current = nil

  for line_number, line in ipairs(lines) do
    local rest = match_marker(line)
    if rest ~= nil then
      if current then
        current.end_line = line_number - 1
        table.insert(parsed, current)
      end
      local is_markdown = rest:match("^%s*%[markdown%]") ~= nil
      local is_raw = rest:match("^%s*%[raw%]") ~= nil
      local cell_type = is_markdown and "markdown" or (is_raw and "raw" or "code")
      current = {
        start_line = line_number,
        cell_type = cell_type,
        tags = parse_tags(rest),
        editable = parse_bool_attr(rest, "editable"),
        deletable = parse_bool_attr(rest, "deletable"),
      }
    end
  end

  if current then
    current.end_line = #lines
    table.insert(parsed, current)
  end

  return parsed
end

function M.snapshot(bufnr)
  local changedtick = vim.api.nvim_buf_get_changedtick(bufnr)
  if bufnr == cached_bufnr and changedtick == cached_changedtick then
    return cached_cells, cached_lines
  end

  local lines = vim.api.nvim_buf_get_lines(bufnr, 0, -1, false)
  local parsed = M.parse_lines(lines)
  cached_bufnr = bufnr
  cached_changedtick = changedtick
  cached_cells = parsed
  cached_lines = lines
  return parsed, lines
end

function M.invalidate(bufnr)
  if bufnr ~= nil and bufnr ~= cached_bufnr then
    return
  end
  cached_bufnr = nil
  cached_changedtick = nil
  cached_cells = nil
  cached_lines = nil
end

function M.parse(bufnr)
  local parsed = M.snapshot(bufnr)
  return parsed
end

function M.cell_index_at(parsed, line)
  for position, cell in ipairs(parsed) do
    if line >= cell.start_line and line <= cell.end_line then
      return position - 1, cell
    end
  end
  return nil
end

function M.cell_after(parsed, index)
  return parsed[index + 2]
end

function M.cell_before(parsed, index)
  return parsed[index]
end

--- Extracts body lines after the marker, trimming a single trailing blank
--- inter-cell separator line when another cell follows.
local function cell_body(lines, cell)
  local body = {}
  for line_number = cell.start_line + 1, cell.end_line do
    table.insert(body, lines[line_number])
  end
  if #body > 0 and body[#body] == "" and cell.end_line < #lines then
    table.remove(body)
  end
  return body
end

function M.source_from_lines(lines, cell)
  local body = cell_body(lines, cell)
  return table.concat(body, "\n")
end

function M.source(bufnr, cell)
  local _, lines = M.snapshot(bufnr)
  return M.source_from_lines(lines, cell)
end

function M.display_source_from_lines(lines, cell)
  if cell.cell_type ~= "markdown" and cell.cell_type ~= "raw" then
    return M.source_from_lines(lines, cell)
  end
  local body = cell_body(lines, cell)
  for line_number, line in ipairs(body) do
    body[line_number] = (line:gsub("^# ?", "", 1))
  end
  return table.concat(body, "\n")
end

function M.display_source(bufnr, cell)
  local _, lines = M.snapshot(bufnr)
  return M.display_source_from_lines(lines, cell)
end

return M
</file>

<file path="lua/ipynb-peek/server.lua">
local M = {}

local job_id = nil
local next_request_id = 0
local pending = {}
local stopping = false

M.port = nil
M.url = nil
M.ready = false
M.error = nil
M.token = nil

--- Resolves the Python executable to launch `python/server.py`.
function M.find_python(configured)
  if type(configured) == "string" and configured ~= "" then
    return configured
  end
  if vim.fn.executable("python3") == 1 then
    return "python3"
  end
  if vim.fn.executable("python") == 1 then
    return "python"
  end
  return nil
end

local function handle_line(line, opts)
  if line == "" then
    return
  end
  local ok, msg = pcall(vim.json.decode, line)
  if not ok or type(msg) ~= "table" then
    vim.schedule(function()
      vim.notify("[ipynb-peek] received malformed server output: " .. line, vim.log.levels.WARN)
    end)
    return
  end
  if msg.type == "ready" then
    M.token = msg.token
    M.url = msg.url
    M.port = msg.port
    M.ready = M.token ~= nil and M.url ~= nil and M.port ~= nil
    if M.ready and opts.on_ready then
      vim.schedule(opts.on_ready)
    end
  elseif msg.type == "response" then
    local callback = pending[msg.id]
    pending[msg.id] = nil
    if callback then
      vim.schedule(function()
        callback(msg)
      end)
    end
  elseif opts.on_event then
    vim.schedule(function()
      opts.on_event(msg)
    end)
  end
end

--- Starts the Python preview/kernel server (`python/server.py`).
--- opts.server_script: absolute path to `python/server.py`
--- opts.python: optional Python executable path/name
--- opts.on_ready(), opts.on_event(event), opts.on_exit()
function M.start(opts)
  opts = opts or {}
  if job_id then
    return true
  end

  local python = M.find_python(opts.python)
  if not python then
    M.error = "python3 not found on PATH"
    return false
  end

  M.port = nil
  M.url = nil
  M.ready = false
  M.error = nil
  M.token = nil
  stopping = false

  local stdout_partial = ""
  local started_job_id
  started_job_id = vim.fn.jobstart({ python, "-u", opts.server_script }, {
    stdout_buffered = false,
    on_stdout = function(_, data)
      if job_id ~= started_job_id then
        return
      end
      data[1] = stdout_partial .. data[1]
      stdout_partial = table.remove(data)
      for _, line in ipairs(data) do
        handle_line(line, opts)
      end
    end,
    on_stderr = function(_, data)
      if job_id ~= started_job_id then
        return
      end
      for _, line in ipairs(data) do
        if line ~= "" then
          vim.schedule(function()
            vim.notify("[ipynb-peek] " .. line, vim.log.levels.WARN)
          end)
        end
      end
    end,
    on_exit = function(_, exit_code)
      if job_id ~= started_job_id then
        return
      end
      local was_ready = M.ready
      job_id = nil
      M.fail_pending("preview server exited")
      M.ready = false
      M.url = nil
      M.port = nil
      M.token = nil
      if not stopping then
        M.error = "preview server exited unexpectedly (exit " .. exit_code .. ")"
        if was_ready then
          vim.schedule(function()
            vim.notify("[ipynb-peek] " .. M.error, vim.log.levels.ERROR)
          end)
        end
        if opts.on_exit then
          vim.schedule(opts.on_exit)
        end
      end
    end,
  })
  if started_job_id <= 0 then
    M.error = "failed to start Python preview server (jobstart returned " .. started_job_id .. ")"
    M.port = nil
    M.token = nil
    return false
  end
  job_id = started_job_id
  return true
end

function M.send(command_type, fields, on_result)
  if not job_id or not M.ready then
    vim.notify("[ipynb-peek] server not running", vim.log.levels.WARN)
    return false
  end
  local msg = vim.tbl_extend("force", fields or {}, { type = command_type })
  if on_result then
    next_request_id = next_request_id + 1
    msg.id = next_request_id
    pending[msg.id] = on_result
  end
  local ok = pcall(vim.fn.chansend, job_id, vim.json.encode(msg) .. "\n")
  if not ok then
    if msg.id then
      pending[msg.id] = nil
    end
    vim.notify("[ipynb-peek] failed to write to the preview server", vim.log.levels.WARN)
    return false
  end
  return true
end

function M.fail_pending(reason)
  local callbacks = pending
  pending = {}
  for _, callback in pairs(callbacks) do
    vim.schedule(function()
      callback({ ok = false, error = reason })
    end)
  end
end

function M.stop()
  stopping = true
  M.fail_pending("preview server stopped")
  if job_id then
    vim.fn.jobstop(job_id)
    job_id = nil
    M.ready = false
    M.url = nil
  end
  M.port = nil
  M.token = nil
  M.error = nil
end

return M
</file>

<file path="tests/cells_spec.lua">
local cells = require("ipynb-peek.cells")

local function make_buffer(lines)
  local bufnr = vim.api.nvim_create_buf(false, true)
  vim.api.nvim_buf_set_lines(bufnr, 0, -1, false, lines)
  return bufnr
end

describe("cells.parse", function()
  it("returns an empty table for a buffer with no `# %%` markers", function()
    local bufnr = make_buffer({ "import numpy as np", "np.array([1, 2, 3])" })
    assert.are.same({}, cells.parse(bufnr))
  end)

  it("parses a single code cell running to the end of the buffer", function()
    local bufnr = make_buffer({ "# %%", "1 + 1" })
    local parsed = cells.parse(bufnr)
    assert.are.equal(1, #parsed)
    assert.are.same(
      { start_line = 1, end_line = 2, cell_type = "code", tags = {}, editable = true, deletable = true },
      parsed[1]
    )
  end)

  it("supports `#%%` without a space", function()
    local bufnr = make_buffer({ "#%%", "x = 1", "#%% [markdown]", "# hi" })
    local parsed = cells.parse(bufnr)
    assert.are.equal(2, #parsed)
    assert.are.equal("code", parsed[1].cell_type)
    assert.are.equal("markdown", parsed[2].cell_type)
  end)

  it("does NOT split cells on `# %%timeit` or `# %%bash`", function()
    local bufnr = make_buffer({ "# %%", "# %%timeit", "x = 1", "# %%bash", "y = 2" })
    local parsed = cells.parse(bufnr)
    assert.are.equal(1, #parsed)
    assert.are.equal(1, parsed[1].start_line)
    assert.are.equal(5, parsed[1].end_line)
  end)

  it("splits multiple cells at each `# %%` marker", function()
    local bufnr = make_buffer({ "# %%", "1 + 1", "# %%", "2 + 2" })
    local parsed = cells.parse(bufnr)
    assert.are.equal(2, #parsed)
    assert.are.equal(1, parsed[1].start_line)
    assert.are.equal(2, parsed[1].end_line)
    assert.are.equal(3, parsed[2].start_line)
    assert.are.equal(4, parsed[2].end_line)
  end)

  it("detects `# %% [markdown]` and `# %% [raw]` markers", function()
    local bufnr = make_buffer({ "# %% [markdown]", "# hello", "# %% [raw]", "# raw" })
    local parsed = cells.parse(bufnr)
    assert.are.equal("markdown", parsed[1].cell_type)
    assert.are.equal("raw", parsed[2].cell_type)
  end)

  it("ignores buffer content before the first marker", function()
    local bufnr = make_buffer({ "# a leading comment", "# %%", "code" })
    local parsed = cells.parse(bufnr)
    assert.are.equal(1, #parsed)
    assert.are.equal(2, parsed[1].start_line)
  end)

  it("parses mixed-quote tags in order without bogus apostrophe splits", function()
    local bufnr = make_buffer({ [=[# %% tags=["a'b", 'second', "third"]]=], "1 + 1" })
    local parsed = cells.parse(bufnr)
    assert.are.same({ "a'b", "second", "third" }, parsed[1].tags)
  end)

  it("enforces word boundaries for editable=false and deletable=false", function()
    local bufnr = make_buffer({
      "# %% uneditable=false undeletable=false",
      "1",
      "# %% deletable=false editable=false",
      "2",
    })
    local parsed = cells.parse(bufnr)
    assert.is_true(parsed[1].editable)
    assert.is_true(parsed[1].deletable)
    assert.is_false(parsed[2].editable)
    assert.is_false(parsed[2].deletable)
  end)

  it("reuses a parsed snapshot until changedtick advances and can invalidate", function()
    local bufnr = make_buffer({ "# %%", "1 + 1" })
    local first = cells.parse(bufnr)
    assert.is_true(rawequal(first, cells.parse(bufnr)))

    vim.api.nvim_buf_set_lines(bufnr, 2, 2, false, { "# %%", "2 + 2" })
    local updated = cells.parse(bufnr)
    assert.is_false(rawequal(first, updated))
    assert.are.equal(2, #updated)

    cells.invalidate(bufnr)
    assert.is_false(rawequal(updated, cells.parse(bufnr)))
  end)
end)

describe("cells navigation helpers", function()
  it("resolves cell_index_at, cell_after, and cell_before", function()
    local bufnr = make_buffer({ "# leading", "# %%", "1", "# %%", "2", "# %%", "3" })
    local parsed = cells.parse(bufnr)

    assert.is_nil(cells.cell_index_at(parsed, 1))
    local idx, cell = cells.cell_index_at(parsed, 5)
    assert.are.equal(1, idx)
    assert.are.equal("code", cell.cell_type)
    assert.are.same(parsed[3], cells.cell_after(parsed, 1))
    assert.is_nil(cells.cell_after(parsed, 2))
    assert.are.same(parsed[1], cells.cell_before(parsed, 1))
    assert.is_nil(cells.cell_before(parsed, 0))
  end)
end)

describe("cells.source and display_source", function()
  it("preserves comments like `# !TODO` and `# ?why` verbatim (no magic mangling)", function()
    local bufnr = make_buffer({ "# %%", "# !TODO: fix this", "# ?why does this work", "x = 1" })
    local parsed = cells.parse(bufnr)
    assert.are.equal("# !TODO: fix this\n# ?why does this work\nx = 1", cells.source(bufnr, parsed[1]))
  end)

  it("trims a single trailing blank inter-cell separator line when followed by another cell", function()
    local bufnr = make_buffer({ "# %%", "a = 1", "", "# %%", "b = 2", "" })
    local parsed = cells.parse(bufnr)
    assert.are.equal("a = 1", cells.source(bufnr, parsed[1]))
    -- Last cell preserves its own trailing blank line
    assert.are.equal("b = 2\n", cells.source(bufnr, parsed[2]))
  end)

  it("strips `# ` comment prefixes in markdown and raw cells", function()
    local bufnr = make_buffer({
      "# %% [markdown]",
      "# # Title",
      "#",
      "# paragraph",
      "",
      "# %% [raw]",
      "# raw text",
    })
    local parsed = cells.parse(bufnr)
    assert.are.equal("# Title\n\nparagraph", cells.display_source(bufnr, parsed[1]))
    assert.are.equal("raw text", cells.display_source(bufnr, parsed[2]))
  end)
end)
